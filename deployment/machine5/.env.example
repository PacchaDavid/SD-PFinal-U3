# =============================================================================
# Máquina 5: Microservicio Pagos - EJEMPLO
# Copiar a .env y ajustar IPs
# =============================================================================
MACHINE_ID=5
MACHINE_NAME="Microservicio Pagos"

# Components
ENABLE_PAGOS_SERVICE=true
ENABLE_PAGOS_DB_PRIMARY=true
ENABLE_PAGOS_DB_REPLICA1=true
ENABLE_PAGOS_DB_REPLICA2=true
ENABLE_PAGOS_DB_REPLICA3=true
ENABLE_PAGOS_REPLICATION=true

# Service
PAGOS_PORT=8083

# Databases
DB_PRIMARY_PORT=3315
DB_REPLICA1_PORT=3316
DB_REPLICA2_PORT=3317
DB_REPLICA3_PORT=3318

# Redis connection (Machine 2)
REDIS_HOST=192.168.1.102
REDIS_PORT=6379

# Event Monitor connection (Machine 2)
EVENT_MONITOR_URL=http://192.168.1.102:8082

# Docker Compose profile
COMPOSE_PROFILE=machine5

# Network
MACHINE_IP=192.168.1.105
DOCKER_NETWORK_SUBNET=172.27.5.0/24

# Replication
QUORUM_MIN=2
POLL_INTERVAL=500
REPLICA_TIMEOUT=3000

# Logging
LOG_LEVEL=INFO
