# =============================================================================
# Máquina 4: Microservicio Recomendaciones - EJEMPLO
# Copiar a .env y ajustar IPs
# =============================================================================
MACHINE_ID=4
MACHINE_NAME="Microservicio Recomendaciones"

# Components
ENABLE_RECOMENDACIONES_SERVICE=true
ENABLE_RECOMENDACIONES_DB_PRIMARY=true
ENABLE_RECOMENDACIONES_DB_REPLICA1=true
ENABLE_RECOMENDACIONES_DB_REPLICA2=true
ENABLE_RECOMENDACIONES_DB_REPLICA3=true
ENABLE_RECOMENDACIONES_REPLICATION=true

# Service
RECOMENDACIONES_PORT=8091

# Databases
DB_PRIMARY_PORT=3311
DB_REPLICA1_PORT=3312
DB_REPLICA2_PORT=3313
DB_REPLICA3_PORT=3314

# Redis connection (Machine 2)
REDIS_HOST=192.168.1.102
REDIS_PORT=6379

# Event Monitor connection (Machine 2)
EVENT_MONITOR_URL=http://192.168.1.102:8082

# Docker Compose profile
COMPOSE_PROFILE=machine4

# Network
MACHINE_IP=192.168.1.104
DOCKER_NETWORK_SUBNET=172.27.4.0/24

# Replication
QUORUM_MIN=2
POLL_INTERVAL=500
REPLICA_TIMEOUT=3000

# Logging
LOG_LEVEL=INFO
