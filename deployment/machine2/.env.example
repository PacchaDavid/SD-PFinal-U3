# =============================================================================
# Máquina 2: Infraestructura Central - EJEMPLO
# Copiar a .env y ajustar IPs
# =============================================================================
MACHINE_ID=2
MACHINE_NAME="Infraestructura Central"

# Components to run
ENABLE_EVENT_MONITOR=true
ENABLE_LOAD_BALANCER=true
ENABLE_REDIS=true

# Event Monitor
EVENT_MONITOR_PORT=8082
EVENT_MONITOR_HOST=0.0.0.0

# Circuit Breaker
CIRCUIT_BREAKER_PORT=8084
CIRCUIT_BREAKER_HOST=0.0.0.0

# Load Balancer
LOAD_BALANCER_PORT=8000
LOAD_BALANCER_HOST=0.0.0.0

# Redis — Puerto (listen) y host de conexión para otros servicios
REDIS_PORT=6379
REDIS_HOST=redis

# Docker Compose profile
COMPOSE_PROFILE=machine2

# Network
MACHINE_IP=192.168.2.102
DOCKER_NETWORK_SUBNET=172.27.2.0/24

# Backend services hosts y puertos (IPs de Máquinas 3, 4, 5)
# El Load Balancer las necesita para enrutar tráfico
USUARIOS_SERVICE_HOST=192.168.2.103
USUARIOS_SERVICE_PORT=8081
RECOMENDACIONES_SERVICE_HOST=192.168.2.104
RECOMENDACIONES_SERVICE_PORT=8091
PAGOS_SERVICE_HOST=192.168.2.105
PAGOS_SERVICE_PORT=8083

# Logging
LOG_LEVEL=INFO
