# =============================================================================
# Máquina 3: Microservicio Usuarios - EJEMPLO
# Copiar a .env y ajustar IPs
# =============================================================================
MACHINE_ID=3
MACHINE_NAME="Microservicio Usuarios"

# Components
ENABLE_USUARIOS_SERVICE=true
ENABLE_USUARIOS_DB_PRIMARY=true
ENABLE_USUARIOS_DB_REPLICA1=true
ENABLE_USUARIOS_DB_REPLICA2=true
ENABLE_USUARIOS_DB_REPLICA3=true
ENABLE_USUARIOS_REPLICATION=true

# Service
USUARIOS_PORT=8081

# Databases
DB_PRIMARY_PORT=3307
DB_REPLICA1_PORT=3308
DB_REPLICA2_PORT=3309
DB_REPLICA3_PORT=3310

# Redis connection (Machine 2)
REDIS_HOST=192.168.1.102
REDIS_PORT=6379

# Event Monitor connection (Machine 2)
EVENT_MONITOR_URL=http://192.168.1.102:8082

# Docker Compose profile
COMPOSE_PROFILE=machine3

# Network
MACHINE_IP=192.168.1.103
DOCKER_NETWORK_SUBNET=172.27.3.0/24

# Replication
QUORUM_MIN=2
POLL_INTERVAL=500
REPLICA_TIMEOUT=3000

# Logging
LOG_LEVEL=INFO
