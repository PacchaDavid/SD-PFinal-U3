# =============================================================================
# Máquina 1: Frontend Web - EJEMPLO
# Copiar a .env y ajustar IPs
# =============================================================================
MACHINE_ID=1
MACHINE_NAME="Frontend Web"

# Frontend — El Load Balancer corre en Máquina 2
REACT_APP_API_HOST=192.168.1.102            # IP de Máquina 2 (Load Balancer)
REACT_APP_EVENT_MONITOR_HOST=192.168.1.102  # IP de Máquina 2 (Event Monitor)

# IP de la Máquina 2 (Infraestructura) — usada por docker-compose
MACHINE2_IP=192.168.1.102

# Docker Compose profile
COMPOSE_PROFILE=machine1

# Network
MACHINE_IP=192.168.1.101
DOCKER_NETWORK_SUBNET=172.27.1.0/24
