# =============================================================================
# .gitignore - Plataforma Distribuida de Streaming
# =============================================================================

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/build/
frontend/.env.local
npm-debug.log*

# --- Java / Maven ---
target/
*.class
*.jar
*.war
*.ear
*.nar
.settings/
.project
.classpath
*.iml
.idea/
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.eggs/
dist/
build/
*.egg

# --- Docker ---
.docker/

# --- Environment ---
.env
!.env.example
*.env.local

# --- IDE ---
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Deployment ---
deployment/*/.env
!deployment/*/.env.example

# --- Misc ---
*.bak
*.tmp
*.pid
*.seed
*.pid.lock
