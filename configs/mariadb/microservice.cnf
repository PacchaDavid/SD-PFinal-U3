# =============================================================================
# MariaDB Configuración para Microservicios
# Plataforma Distribuida de Streaming
# =============================================================================
# NOTA: No se utiliza replicación nativa de MariaDB ni Galera.
# La replicación es gestionada por el Replication Manager (Python).

[mysqld]

# --- Caracteres ---
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# --- Conexiones ---
max_connections = 100
connect_timeout = 5
wait_timeout = 600

# --- InnoDB ---
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT

# --- Logs ---
log_error = /var/lib/mysql/error.log
general_log = 0
slow_query_log = 1
long_query_time = 2

# --- Performance ---
performance_schema = ON
table_open_cache = 400
thread_cache_size = 8

# --- Seguridad ---
skip-name-resolve
local-infile = 0

[client]
default-character-set = utf8mb4
